{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "openrsc-ledger admin API",
    "description" : "Read-only stats for an OpenRSC server.",
    "version" : "0.1.0"
  },
  "externalDocs" : {
    "url" : "/"
  },
  "servers" : [ ],
  "tags" : [ ],
  "paths" : {
    "/api/health" : {
      "get" : {
        "tags" : [ ],
        "description" : "Whether the ledger is running, and how fresh its data is.",
        "parameters" : [ ],
        "responses" : {
          "200" : {
            "description" : "The ledger is running.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    },
    "/api/players" : {
      "get" : {
        "tags" : [ ],
        "description" : "Every player on the server, sorted by name.",
        "parameters" : [ {
          "name" : "search",
          "in" : "query",
          "description" : "Only players whose name contains this, ignoring case.",
          "required" : false,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The players, from the latest copy of the server's database.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PlayerList"
                }
              }
            }
          },
          "503" : {
            "description" : "The ledger hasn't copied the server's database yet.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    },
    "/api/players/{id}" : {
      "get" : {
        "tags" : [ ],
        "description" : "One player's skills, quests, equipment, inventory and bank.",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "description" : "The player's id, from the player list.",
          "required" : true,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The player, from the latest copy of the server's database.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PlayerPage"
                }
              }
            }
          },
          "404" : {
            "description" : "There's no player with that id.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          },
          "503" : {
            "description" : "The ledger hasn't copied the server's database yet.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    },
    "/api/leaderboards" : {
      "get" : {
        "tags" : [ ],
        "description" : "The leaderboards there are: overall, then one per skill.",
        "parameters" : [ ],
        "responses" : {
          "200" : {
            "description" : "The boards.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BoardList"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    },
    "/api/leaderboards/{board}" : {
      "get" : {
        "tags" : [ ],
        "description" : "Every player ranked on one board.",
        "parameters" : [ {
          "name" : "board",
          "in" : "path",
          "description" : "`overall`, or a skill's key such as `woodcut`.",
          "required" : true,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "staff",
          "in" : "query",
          "description" : "`true` to rank the server's staff too. They're left out otherwise, and ranks are counted without them.",
          "required" : false,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "boolean"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The board, from the latest copy of the server's database.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Leaderboard"
                }
              }
            }
          },
          "404" : {
            "description" : "There's no board by that name.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          },
          "503" : {
            "description" : "The ledger hasn't copied the server's database yet.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    },
    "/api/economy" : {
      "get" : {
        "tags" : [ ],
        "description" : "Total coins, and how much of every item is held, across every inventory and bank. Noted items count as the item.",
        "parameters" : [ ],
        "responses" : {
          "200" : {
            "description" : "The economy, from the latest copy of the server's database.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EconomyReport"
                }
              }
            }
          },
          "503" : {
            "description" : "The ledger hasn't copied the server's database yet.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    }
  },
  "components" : {
    "schemas" : {
      "Health" : {
        "type" : "object",
        "properties" : {
          "status" : {
            "type" : "string"
          },
          "dataCopiedAt" : {
            "type" : [ "null", "string" ]
          }
        },
        "required" : [ "status" ]
      },
      "PlayerListItem" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : "string"
          },
          "combatLevel" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalLevel" : {
            "type" : "integer",
            "format" : "int32"
          },
          "lastLogin" : {
            "type" : [ "null", "string" ]
          },
          "online" : {
            "type" : "boolean"
          }
        },
        "required" : [ "combatLevel", "id", "name", "online", "totalLevel" ]
      },
      "PlayerList" : {
        "type" : "object",
        "properties" : {
          "players" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/PlayerListItem"
            }
          }
        },
        "required" : [ "players" ]
      },
      "NoData" : {
        "type" : "object",
        "properties" : {
          "message" : {
            "type" : "string"
          }
        },
        "required" : [ "message" ]
      },
      "SkillRow" : {
        "type" : "object",
        "properties" : {
          "skill" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          },
          "level" : {
            "type" : "integer",
            "format" : "int32"
          },
          "fullLevel" : {
            "type" : "integer",
            "format" : "int32"
          },
          "experience" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "experience", "fullLevel", "level", "name", "skill" ]
      },
      "QuestRow" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : [ "null", "string" ]
          },
          "stage" : {
            "type" : "integer",
            "format" : "int32"
          },
          "complete" : {
            "type" : "boolean"
          }
        },
        "required" : [ "complete", "id", "stage" ]
      },
      "ItemRow" : {
        "type" : "object",
        "properties" : {
          "slot" : {
            "type" : "integer",
            "format" : "int32"
          },
          "itemId" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : [ "null", "string" ]
          },
          "amount" : {
            "type" : "integer",
            "format" : "int32"
          },
          "noted" : {
            "type" : "boolean"
          },
          "worn" : {
            "type" : "boolean"
          }
        },
        "required" : [ "amount", "itemId", "noted", "slot", "worn" ]
      },
      "PlayerPage" : {
        "type" : "object",
        "properties" : {
          "player" : {
            "$ref" : "#/components/schemas/PlayerListItem"
          },
          "questPoints" : {
            "type" : "integer",
            "format" : "int32"
          },
          "skills" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/SkillRow"
            }
          },
          "quests" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/QuestRow"
            }
          },
          "equipment" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ItemRow"
            }
          },
          "inventory" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ItemRow"
            }
          },
          "bank" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ItemRow"
            }
          }
        },
        "required" : [ "bank", "equipment", "inventory", "player", "questPoints", "quests", "skills" ]
      },
      "Board" : {
        "type" : "object",
        "properties" : {
          "key" : {
            "type" : "string"
          },
          "name" : {
            "type" : "string"
          }
        },
        "required" : [ "key", "name" ]
      },
      "BoardList" : {
        "type" : "object",
        "properties" : {
          "boards" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/Board"
            }
          }
        },
        "required" : [ "boards" ]
      },
      "LeaderboardEntry" : {
        "type" : "object",
        "properties" : {
          "rank" : {
            "type" : "integer",
            "format" : "int32"
          },
          "playerId" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : "string"
          },
          "level" : {
            "type" : "integer",
            "format" : "int32"
          },
          "experience" : {
            "type" : "integer",
            "format" : "int64"
          },
          "staff" : {
            "type" : "boolean"
          }
        },
        "required" : [ "experience", "level", "name", "playerId", "rank", "staff" ]
      },
      "Leaderboard" : {
        "type" : "object",
        "properties" : {
          "board" : {
            "$ref" : "#/components/schemas/Board"
          },
          "entries" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/LeaderboardEntry"
            }
          }
        },
        "required" : [ "board", "entries" ]
      },
      "Holdings" : {
        "type" : "object",
        "properties" : {
          "inInventories" : {
            "type" : "integer",
            "format" : "int64"
          },
          "inBanks" : {
            "type" : "integer",
            "format" : "int64"
          },
          "total" : {
            "type" : "integer",
            "format" : "int64"
          }
        },
        "required" : [ "inBanks", "inInventories", "total" ]
      },
      "ItemHoldings" : {
        "type" : "object",
        "properties" : {
          "itemId" : {
            "type" : "integer",
            "format" : "int32"
          },
          "name" : {
            "type" : [ "null", "string" ]
          },
          "held" : {
            "$ref" : "#/components/schemas/Holdings"
          },
          "holders" : {
            "type" : "integer",
            "format" : "int32"
          }
        },
        "required" : [ "held", "holders", "itemId" ]
      },
      "EconomyReport" : {
        "type" : "object",
        "properties" : {
          "coins" : {
            "$ref" : "#/components/schemas/Holdings"
          },
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/ItemHoldings"
            }
          }
        },
        "required" : [ "coins", "items" ]
      }
    },
    "examples" : { }
  },
  "webhooks" : { }
}
