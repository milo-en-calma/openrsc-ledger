                }
              }
            }
          }
        },
        "deprecated" : false
      }
    },
    "/api/items/{itemId}/holders" : {
      "get" : {
        "tags" : [ ],
        "description" : "Everyone holding one item, in their inventory or bank. Noted items count as the item.",
        "parameters" : [ {
          "name" : "itemId",
          "in" : "path",
          "description" : "The item's number, as the economy lists it.",
          "required" : true,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The item's holders, from the latest copy of the server's database. Empty if nobody holds it.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ItemHolders"
                }
              }
            }
          },
          "404" : {
            "description" : "The game data names no item with that number, and nobody holds one.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          },
          "503" : {
            "description" : "The ledger hasn't copied the server's database yet.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    },
    "/api/history/gains" : {
      "get" : {
        "tags" : [ ],
        "description" : "How much experience each player gained in each skill over a period, from the ledger's recorded history. A gain runs from the newest value recorded at or before `from` to the newest at or before `to`; a player first recorded inside the period counts from that first value, not from zero. A skill whose experience went down (only an admin command can do that) isn't a gain, and is left out.",
        "parameters" : [ {
          "name" : "from",
          "in" : "query",
          "description" : "The period's start, an ISO-8601 time such as 2026-01-01T00:00:00Z.",
          "required" : false,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "to",
          "in" : "query",
          "description" : "The period's end, an ISO-8601 time. Now, if left out.",
          "required" : false,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "player",
          "in" : "query",
          "description" : "Only this player's gains, by id.",
          "required" : false,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        }, {
          "name" : "skill",
          "in" : "query",
          "description" : "Only gains in this skill, by key, such as `woodcut`.",
          "required" : false,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "staff",
          "in" : "query",
          "description" : "`true` to include the server's staff, as on the leaderboards. They're left out otherwise. A player no longer in the server's database counts as not staff.",
          "required" : false,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "boolean"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The gains, most experience first. Empty if nothing changed.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/GainsReport"
                }
              }
            }
          },
          "400" : {
            "description" : "The period, the player, the skill or `staff` couldn't be read.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          },
          "503" : {
            "description" : "The ledger hasn't copied the server's database yet.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    }
  },
