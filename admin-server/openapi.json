{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "openrsc-ledger admin API",
    "description" : "Read-only stats for an OpenRSC server. Errors answer as `{\"message\": \"…\"}`, saying what was wrong; any address under `/api` not listed here answers 404 with \"No such API route.\", and a query value given more than once answers 400, naming it. An address that can't be read at all, such as one with a broken %-escape or a request line over 4,096 bytes, gets a plain-text 400 from the web server instead.",
    "version" : "0.1.0"
  },
  "externalDocs" : {
    "url" : "/"
  },
  "servers" : [ ],
  "tags" : [ ],
  "paths" : {
    "/api/health" : {
      "get" : {
        "tags" : [ ],
        "description" : "Whether the ledger is running, and how fresh its data is.",
        "parameters" : [ ],
        "responses" : {
          "200" : {
            "description" : "The ledger is running.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Health"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    },
    "/api/players" : {
      "get" : {
        "tags" : [ ],
        "description" : "Every player on the server, sorted by name.",
        "parameters" : [ {
          "name" : "search",
          "in" : "query",
          "description" : "Only players whose name contains this, ignoring case.",
          "required" : false,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The players, from the latest copy of the server's database.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PlayerList"
                }
              }
            }
          },
          "400" : {
            "description" : "`search` holds a control character, such as a NUL or a line break, which no name can.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          },
          "503" : {
            "description" : "The ledger hasn't copied the server's database yet.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    },
    "/api/players/{id}" : {
      "get" : {
        "tags" : [ ],
        "description" : "One player's skills, quests, equipment, inventory and bank.",
        "parameters" : [ {
          "name" : "id",
          "in" : "path",
          "description" : "The player's id, from the player list.",
          "required" : true,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The player, from the latest copy of the server's database.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/PlayerPage"
                }
              }
            }
          },
          "404" : {
            "description" : "There's no player with that id, or the player has no maxstats or curstats row, which the server needs to load them too. The answer's message is \"There's no player with that id.\" either way.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          },
          "503" : {
            "description" : "The ledger hasn't copied the server's database yet.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    },
    "/api/leaderboards" : {
      "get" : {
        "tags" : [ ],
        "description" : "The leaderboards there are: overall, then one per skill.",
        "parameters" : [ ],
        "responses" : {
          "200" : {
            "description" : "The boards.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/BoardList"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    },
    "/api/leaderboards/{board}" : {
      "get" : {
        "tags" : [ ],
        "description" : "Every player ranked on one board.",
        "parameters" : [ {
          "name" : "board",
          "in" : "path",
          "description" : "`overall`, or a skill's key such as `woodcut`.",
          "required" : true,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "staff",
          "in" : "query",
          "description" : "`true` to rank the server's staff too. They're left out otherwise, and ranks are counted without them.",
          "required" : false,
          "deprecated" : false,
          "explode" : false,
          "schema" : {
            "type" : "boolean"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "The board, from the latest copy of the server's database.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/Leaderboard"
                }
              }
            }
          },
          "404" : {
            "description" : "There's no board by that name.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          },
          "400" : {
            "description" : "`staff` was given as something other than true or false.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          },
          "503" : {
            "description" : "The ledger hasn't copied the server's database yet.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/NoData"
                }
              }
            }
          }
        },
        "deprecated" : false
      }
    },
    "/api/economy" : {
      "get" : {
        "tags" : [ ],
        "description" : "Total coins, and how much of every item is held, across every inventory and bank. Noted items count as the item.",
        "parameters" : [ ],
        "responses" : {
          "200" : {
            "description" : "The economy, from the latest copy of the server's database.",
            "headers" : { },
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/EconomyReport"
                }
              }
            }
          },
          "503" : {
            "description" : "The ledger hasn't copied the server's database yet.",
